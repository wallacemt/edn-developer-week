# URL de invocação da API Gateway existente (stage dev), usada só para criar pedidos
API_GATEWAY_URL=https://SEU_API_ID.execute-api.us-west-1.amazonaws.com/dev

# Recursos já provisionados nos Dias 1 a 4 — o front só lê/escreve neles via SDK AWS
DYNAMODB_TABLE_NAME=pedidos-db-wallacesantana
EVENT_BUS_NAME=pedidos-event-bus-wallacesantana
AWS_REGION=us-west-1

# Credenciais nunca vão aqui: em produção vêm da IAM instance role do Elastic Beanstalk.
# Para rodar localmente, use `aws configure` / variáveis de ambiente do seu profile AWS.
